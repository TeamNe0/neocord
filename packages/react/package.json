{
  "name": "@neocord/react",
  "version": "0.1.0",
  "description": "Compose Discord messages, replies and modals with React.",
  "type": "module",
  "license": "MIT",
  "keywords": ["neocord", "discord", "discord.js", "react", "components-v2", "renderer"],
  "sideEffects": false,
  "files": ["dist"],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "bun check",
    "test": "bun test",
    "check:package": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@neocord/routing": "workspace:^",
    "react-reconciler": "catalog:"
  },
  "peerDependencies": {
    "discord.js": "^14.28.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@neocord/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-reconciler": "catalog:",
    "@typescript/native": "catalog:",
    "discord.js": "catalog:",
    "publint": "catalog:",
    "react": "catalog:"
  }
}
