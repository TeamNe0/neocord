generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Note {
  userId    String   @id @map("user_id") @db.VarChar(32)
  content   String   @db.VarChar(500)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notes")
}
