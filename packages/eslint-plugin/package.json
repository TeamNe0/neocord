{
  "name": "@neocord/eslint-plugin",
  "version": "0.1.0",
  "description": "ESLint rules that enforce neocord file conventions and Discord bot best practices.",
  "type": "module",
  "license": "MIT",
  "keywords": ["neocord", "discord", "eslint", "eslintplugin", "eslint-plugin"],
  "sideEffects": false,
  "files": ["dist"],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "bun check",
    "test": "bun test",
    "check:package": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@neocord/routing": "workspace:^"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@neocord/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:"
  }
}
