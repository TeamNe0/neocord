{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".neocord/build/**"],
      "env": ["VITE_SITE_URL", "VITE_TRAILING_SLASH"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "neocord#typecheck": {
      "dependsOn": ["build"]
    },
    "@teamneo/neocord-docs#test": {
      "dependsOn": ["build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "check:package": {
      "dependsOn": ["build"]
    }
  }
}
